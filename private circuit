<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex,nofollow">
<meta name="theme-color" content="#000C1F">
<title>The Circuit · Private Contributor Room</title>
<style>
:root{--navy:#000c1f;--paper:#f8f6f0;--ink:#09141e;--muted:#69737a;--line:#d9d6ce;--cyan:#05bcd4;--white:#fff}
*{box-sizing:border-box}html,body{margin:0;background:var(--paper);color:var(--ink);font-family:Arial,sans-serif}button,input,textarea{font:inherit}button{cursor:pointer}
.top{height:72px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 4vw;background:rgba(248,246,240,.97);position:sticky;top:0;z-index:10}
.brand{display:flex;gap:12px;align-items:center;font-size:10px;font-weight:bold;letter-spacing:.17em;text-transform:uppercase}.mark{width:31px;height:31px;border:2px solid var(--navy);border-radius:50%;position:relative}.mark:after{content:"";position:absolute;inset:6px;border:1px solid var(--navy);border-radius:50%}
.lock{font-size:9px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}
.screen{display:none;min-height:calc(100vh - 72px)}.screen.active{display:block}
.login{background:var(--navy);color:white;min-height:calc(100vh - 72px);display:grid;place-items:center;padding:40px}.loginbox{width:min(760px,100%)}.kicker{font-size:9px;font-weight:bold;letter-spacing:.18em;text-transform:uppercase;color:var(--muted)}.login .kicker{color:#aab6c0}
h1{font:400 clamp(58px,9vw,112px)/.86 Georgia,serif;letter-spacing:-.06em;margin:20px 0 28px}.login p{font:17px/1.6 Georgia,serif;color:#c3ccd3;max-width:550px}
.btn{border:1px solid var(--navy);background:var(--navy);color:#fff;padding:13px 17px;font-size:9px;font-weight:bold;letter-spacing:.12em;text-transform:uppercase}.login .btn{background:var(--cyan);border-color:var(--cyan);color:var(--navy);margin-top:20px}.btn.ghost{background:transparent;color:var(--navy)}.btn.cyan{background:var(--cyan);border-color:var(--cyan);color:var(--navy)}
.shell{max-width:1240px;margin:auto;padding:50px 5vw 90px;display:grid;grid-template-columns:220px 1fr;gap:50px}.side{position:sticky;top:110px;align-self:start}.avatar{width:52px;height:52px;border-radius:50%;display:grid;place-items:center;background:var(--navy);color:#fff;font-size:11px;font-weight:bold;margin-bottom:14px}.side b{font-size:11px}.side small{display:block;color:var(--muted);font-size:9px;line-height:1.5;margin-top:4px}.nav{margin-top:25px;border-top:1px solid var(--line)}.nav button{display:block;width:100%;border:0;border-bottom:1px solid var(--line);background:none;text-align:left;padding:13px 0;font-size:9px;text-transform:uppercase;letter-spacing:.1em;font-weight:bold}.nav button.on:after{content:" →";color:var(--cyan)}
.view{display:none}.view.on{display:block}.main h2{font:400 clamp(42px,5vw,66px)/.95 Georgia,serif;letter-spacing:-.045em;margin:10px 0 14px}.lead{font:15px/1.6 Georgia,serif;color:var(--muted);max-width:720px}
.roomcard{background:var(--navy);color:white;padding:30px;margin-top:35px}.roomcard .kicker{color:#aab6c0}.roomcard h3{font:400 34px/1.05 Georgia,serif;margin:12px 0}.roomcard p{font-size:11px;color:#bdc7ce}.roster{display:flex;flex-wrap:wrap;gap:7px;margin:20px 0}.chip{border:1px solid rgba(255,255,255,.2);padding:8px 10px;font-size:9px}
.question{background:white;border-top:4px solid var(--cyan);padding:30px;margin-top:16px}.question blockquote{font:400 clamp(25px,3vw,38px)/1.2 Georgia,serif;margin:14px 0 22px}.actions{display:flex;gap:8px;flex-wrap:wrap}
.feed{margin-top:38px}.feed h3{font:400 30px Georgia,serif}.post{border-top:1px solid var(--line);padding:22px 0;display:grid;grid-template-columns:180px 1fr auto;gap:22px}.post .who{font-size:10px;font-weight:bold}.post .who small{display:block;color:var(--muted);font-weight:normal;margin-top:4px}.post h4{font:400 22px/1.2 Georgia,serif;margin:0 0 8px}.post p{font-size:11px;line-height:1.6;color:var(--muted);margin:0}
.thread{margin-top:35px;max-width:880px}.threaditem{border-top:1px solid var(--line);padding:25px 0}.threaditem b{font-size:10px}.threaditem small{color:var(--muted)}.threaditem p{font:16px/1.65 Georgia,serif}
.editor{max-width:860px}.context{border-bottom:1px solid var(--line);padding:12px 0 18px;margin:20px 0 30px;font-size:9px;font-weight:bold;text-transform:uppercase;letter-spacing:.1em}.cover{height:200px;border:1px dashed #aaa;display:grid;place-items:center;background:#efede7;margin-bottom:30px}.title{width:100%;border:0;background:transparent;outline:0;font:400 clamp(40px,5vw,64px)/1 Georgia,serif;letter-spacing:-.045em;margin-bottom:22px}.body{width:100%;min-height:340px;border:0;background:transparent;outline:0;resize:vertical;font:18px/1.72 Georgia,serif}.tools{border-top:1px solid var(--line);padding-top:15px;display:flex;gap:7px}.tools button{background:white;border:1px solid var(--line);padding:9px 12px;font-size:9px;text-transform:uppercase}.publishbar{display:flex;justify-content:space-between;align-items:center;border-top:1px solid var(--line);margin-top:20px;padding-top:20px}
.success{max-width:760px}.success h2{font-size:74px}.flow{margin:30px 0;border-top:1px solid var(--line)}.flow div{display:flex;justify-content:space-between;padding:13px 0;border-bottom:1px solid var(--line);font-size:10px}.notice{font-size:9px;color:var(--muted);margin-top:24px;line-height:1.6}
.toast{display:none;position:fixed;right:22px;bottom:22px;background:var(--navy);color:white;padding:14px 18px;font-size:10px;z-index:30;max-width:360px}
@media(max-width:800px){.shell{grid-template-columns:1fr}.side{position:static}.nav{display:flex;gap:15px;overflow:auto}.nav button{width:auto;white-space:nowrap;border:0}.post{grid-template-columns:1fr}}
</style>
</head>
<body>
<header class="top"><div class="brand"><span class="mark"></span>The African Circuit</div><div class="lock">Private contributor space · 🔒</div></header>

<section class="screen active" id="login">
 <div class="login"><div class="loginbox"><div class="kicker">The Circuit · Contributor Access</div><h1>The room<br>stays open.</h1><p>This private space is for approved speakers, moderators and contributors to The African Circuit. Continue the conversation you started on stage and publish when you have something worth putting forward.</p><button class="btn" onclick="signIn()">in&nbsp;&nbsp;Continue with LinkedIn</button><div class="notice" style="color:#91a0ab">Prototype only. Production authentication happens on LinkedIn and access is checked by The African Circuit before any room data is returned.</div></div></div>
</section>

<section class="screen" id="app">
 <div class="shell">
  <aside class="side"><div class="avatar">CM</div><b>Christopher Mbanefo</b><small>Founder & CEO · OXI-ZEN<br>LinkedIn connected</small>
   <div class="nav"><button class="on" onclick="show('home',this)">For you</button><button onclick="show('room',this)">Your room</button><button onclick="show('write',this)">Write</button><button onclick="toast('Your private drafts and public Mandates appear here.')">Your work</button><button onclick="logout()">Sign out</button></div>
  </aside>
  <main class="main">
   <div class="view on" id="home"><div class="kicker">Welcome back, Christopher</div><h2>You were part of Mauritius.<br>The conversation continues.</h2><p class="lead">See what has moved in your room, respond when your perspective is useful, or develop an idea for public publication through The Mandate.</p>
    <div class="roomcard"><div class="kicker">Your room · Mauritius 2026 · Panel 01</div><h3>The Next $100bn</h3><p>Where will Africa’s capital come from, and how do we unlock it?</p><div class="roster"><span class="chip">Dr. Drishty Ramdenee · Steward</span><span class="chip">Saurav Chatterjee</span><span class="chip">Joseph Alain Saraka</span><span class="chip">Fee Reinhart</span></div><button class="btn cyan" onclick="show('room')">Enter the room →</button></div>
    <div class="question"><div class="kicker">New in your room · Drishty asked the panel</div><blockquote>“If Africa’s ecological value can be measured, who should ultimately capture its economic value?”</blockquote><div class="actions"><button class="btn" onclick="respond()">Respond privately →</button><button class="btn ghost" onclick="show('room')">Read responses</button></div></div>
    <div class="feed"><div class="kicker">From your fellow contributors</div><h3>What is moving.</h3><div class="post"><div class="who">Saurav Chatterjee<small>CareEdge Ratings Africa</small></div><div><h4>Who actually determines the price of African risk?</h4><p>A contribution inside your private Panel 01 room.</p></div><button class="btn ghost" onclick="show('room')">Read →</button></div><div class="post"><div class="who">Joseph Alain Saraka<small>Cornerstone Strategies</small></div><div><h4>What changes when African institutional capital becomes the starting point?</h4><p>A contribution from the Mauritius network.</p></div><button class="btn ghost" onclick="toast('Cross-room reading can be permissioned in production.')">Read →</button></div></div>
   </div>

   <div class="view" id="room"><div class="kicker">Private room · Mauritius 2026 · Panel 01</div><h2>The Next $100bn</h2><p class="lead">Only approved members of this room can see this discussion. Nothing here is public unless its author explicitly publishes it to The Mandate.</p><div class="question"><div class="kicker">Current question · Dr. Drishty Ramdenee</div><blockquote>If Africa’s ecological value can be measured, who should ultimately capture its economic value?</blockquote><button class="btn" onclick="respond()">Respond privately →</button></div><div class="thread"><div class="threaditem"><b>Christopher Mbanefo <small>· OXI-ZEN</small></b><p>If ecological value exists before a carbon-credit transaction, the ownership question has to be addressed before the financing architecture can be designed.</p><div class="actions"><button class="btn ghost" onclick="writeMandate()">Develop into a Mandate</button><button class="btn ghost" onclick="toast('Private reply opened in production.')">Reply privately</button></div></div><div class="threaditem"><b>Saurav Chatterjee <small>· CareEdge Ratings Africa</small></b><p>Valuation alone is not enough. The market also needs a credible framework for ownership, measurement and risk.</p><div class="actions"><button class="btn ghost" onclick="toast('Private response opened in production.')">Respond</button></div></div></div></div>

   <div class="view" id="write"><div class="editor"><div class="kicker">The Mandate · Contributor Studio</div><h2>Put something forward.</h2><div class="context" id="context">Draft · Private until you publish · Panel 01 · The Next $100bn</div><div class="cover"><div><b style="font:22px Georgia">Add a cover image</b><br><br><button class="btn ghost">Upload image</button></div></div><input id="title" class="title" placeholder="Title"><textarea id="body" class="body" placeholder="Write here…"></textarea><div class="tools"><button>+ Image</button><button>+ Document</button><button>+ Link</button></div><div class="publishbar"><div><b style="font-size:10px">Christopher Mbanefo</b><small style="display:block;color:var(--muted);font-size:9px">OXI-ZEN · LinkedIn connected</small></div><button class="btn" onclick="publish()">Publish to The Mandate →</button></div><div class="notice">Until you press “Publish to The Mandate”, this draft remains inside the private contributor space. Publishing is the explicit boundary between the Room and the public African Circuit website.</div></div></div>

   <div class="view" id="published"><div class="success"><div class="kicker">Public publication</div><h2>You’re live.</h2><p class="lead" id="pubtitle">Your contribution has crossed from the private Circuit into The Mandate.</p><div class="flow"><div><span>Private Room</span><b>Source retained ✓</b></div><div><span>The Mandate</span><b>Published ✓</b></div><div><span>Contributor profile</span><b>Updated ✓</b></div><div><span>RSS</span><b>Added ✓</b></div><div><span>African Circuit LinkedIn</span><b>Ready for distribution ✓</b></div></div><div class="actions"><button class="btn">View public article</button><button class="btn ghost" onclick="toast('Opens LinkedIn share with the public article URL.')">Share on my LinkedIn →</button></div></div></div>
  </main>
 </div>
</section>
<div class="toast" id="toast"></div>
<script>
function signIn(){document.getElementById('login').classList.remove('active');document.getElementById('app').classList.add('active');toast('Prototype sign-in. Production uses LinkedIn + African Circuit approval.')}
function logout(){document.getElementById('app').classList.remove('active');document.getElementById('login').classList.add('active')}
function show(id,btn){document.querySelectorAll('.view').forEach(v=>v.classList.remove('on'));document.getElementById(id).classList.add('on');document.querySelectorAll('.nav button').forEach(b=>b.classList.remove('on'));if(btn)btn.classList.add('on');window.scrollTo({top:0,behavior:'smooth'})}
function respond(){show('write');document.getElementById('context').textContent='Private response · Drishty’s question · Panel 01 · The Next $100bn';document.getElementById('title').placeholder='Your response';}
function writeMandate(){show('write');document.getElementById('context').textContent='Mandate draft · Private until you publish · Developed from Panel 01';document.getElementById('title').placeholder='Article title';}
function publish(){let t=document.getElementById('title'),b=document.getElementById('body');if(!t.value.trim()||!b.value.trim()){toast('Add a title and your contribution first.');return}document.getElementById('pubtitle').innerHTML='<strong>'+t.value.replace(/[<>&]/g,'')+'</strong><br>Christopher Mbanefo · OXI-ZEN';show('published')}
function toast(t){let x=document.getElementById('toast');x.textContent=t;x.style.display='block';clearTimeout(window.tt);window.tt=setTimeout(()=>x.style.display='none',2800)}
</script>
</body></html>
